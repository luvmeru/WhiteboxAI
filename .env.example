# Fail-closed deployment template. For the intentionally isolated local fixture
# workspace, use the shorter development settings documented in README.md.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://whitebox.example.com
WBX_DEMO_MODE=false

# Migration, web runtime, and retention use separate PostgreSQL roles. The
# owner URL is exposed only to the one-shot migration/provisioning containers.
# External PostgreSQL deployments should replace `db` and enable verified TLS.
WBX_MIGRATION_DATABASE_URL=postgresql://whitebox_owner:replace-with-owner-password@db:5432/whitebox
DATABASE_URL=postgresql://whitebox_app:replace-with-app-password@db:5432/whitebox
WBX_RETENTION_DATABASE_URL=postgresql://whitebox_retention:replace-with-retention-password@db:5432/whitebox
WBX_DB_APP_USER=whitebox_app
WBX_DB_APP_PASSWORD=replace-with-independent-app-password
WBX_DB_RETENTION_USER=whitebox_retention
WBX_DB_RETENTION_PASSWORD=replace-with-independent-retention-password
WBX_DB_SSL=false
WBX_DB_SSL_REJECT_UNAUTHORIZED=false
WBX_DB_POOL_SIZE=10

# Generate independent random values with at least 32 characters.
WBX_AUTH_SECRET=replace-with-at-least-32-random-characters
WBX_AUDIT_SECRET=replace-with-another-32-character-secret

# Bootstrap organization owner. Generate the hash with:
# npm run auth:hash-password -- "your strong password"
WBX_ADMIN_EMAIL=owner@example.com
# Keep this value single-quoted so Compose does not interpolate its `$` fields.
WBX_ADMIN_PASSWORD_HASH='scrypt$replace-with-generated-value'
WBX_ORGANIZATION_ID=org-primary
WBX_ORGANIZATION_NAME=Example Organization

# AI. New vacancy authoring/publication and every application stamped
# openai_required fail closed unless this real provider is configured.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Private candidate recording and assessment-artifact storage. Production
# requires an HTTPS S3-compatible endpoint and private bucket; no object URL is
# sent to clients.
WBX_MEDIA_RECEIPT_SECRET=replace-with-a-third-independent-32-character-secret
WBX_MEDIA_S3_ENDPOINT=https://s3.example.com
WBX_MEDIA_S3_REGION=us-east-1
WBX_MEDIA_S3_BUCKET=whitebox-private-evidence
WBX_MEDIA_S3_ACCESS_KEY_ID=replace-with-scoped-access-key
WBX_MEDIA_S3_SECRET_ACCESS_KEY=replace-with-scoped-secret-key
WBX_MEDIA_S3_SESSION_TOKEN=
WBX_MEDIA_S3_FORCE_PATH_STYLE=true
WBX_MEDIA_S3_SSE=AES256
# Required only when WBX_MEDIA_S3_SSE=aws:kms.
WBX_MEDIA_S3_KMS_KEY_ID=
WBX_FFPROBE_PATH=ffprobe
WBX_TRUSTED_PROXY_HEADER=x-forwarded-for
WBX_RETENTION_INTERVAL_SECONDS=300

# PostgreSQL container (docker-compose only)
POSTGRES_DB=whitebox
POSTGRES_USER=whitebox_owner
POSTGRES_PASSWORD=replace-with-owner-password
